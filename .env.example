# ──────────────────────────────────────────────────────────────────────────
# NOBILIX Admin Console — environment configuration
# Copy to .env.local and fill in. NEVER commit real values.
# ──────────────────────────────────────────────────────────────────────────

# --- Firebase Admin (service account) ---
# Option A (recommended on Vercel): base64 of the whole service-account JSON.
#   macOS/Linux:  base64 -i service-account.json
#   Windows PS:   [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
FIREBASE_SERVICE_ACCOUNT_B64=

# Option B: the three discrete fields (use instead of, not with, the B64 above).
# Keep the private key on one line with literal \n for newlines, wrapped in quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Auth.js ---
# Generate: openssl rand -base64 32
AUTH_SECRET=

# --- Encryption key for TOTP secrets at rest (>= 32 chars) ---
# Generate: openssl rand -base64 32
CRM_ENCRYPTION_KEY=

# --- Optional: choose admin passwords for scripts/create-admins.mjs ---
# If set, the seed script uses these instead of generating random ones.
# Use at least 12 characters (the console change-password flow enforces 12).
# Leave blank to auto-generate.
ADMIN_PW_BASEM=
ADMIN_PW_ABANOUB=
ADMIN_PW_RANDY=

# --- Firebase Player Client (public — safe to expose, scoped to TrapMan app) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- MuAPI image generation (server-side only — NEVER expose to the client) ---
# Required for: node scripts/generate-design-assets.mjs --generate
# Must stay in .env.local — never commit or embed in code.
MUAPI_API_KEY=

# --- Google Analytics 4 (console TrapMan overview) ---
# Optional. GA4 property ID used by the Analytics Data API for behavioural
# metrics on the TrapMan console. Falls back to the known TrapMan property
# ("540977563") when unset.
GA4_PROPERTY_ID=

# --- Google Play purchase verification (optional but strongly recommended) ---
# Without this, the console cannot tell a paid Android sale apart from a free
# licence-test purchase, and revenue can only be corrected by hand.
#
# Setup, once:
#   1. Google Cloud console → enable the "Google Play Android Developer API"
#      on the same project as the Firebase service account.
#   2. Play Console → Users and permissions → Invite new user → paste the
#      service account's client_email → grant "View financial data, orders,
#      and cancellation survey responses" for the TrapMan app.
#
# Leave blank to reuse FIREBASE_SERVICE_ACCOUNT_B64 (usual case). Set only if
# a separate service account holds the Play Console grant.
ANDROID_PUBLISHER_SERVICE_ACCOUNT_B64=

# --- App Store Connect: live iOS sales (strongly recommended) ---
# Apple's Sales and Trends reports are the ONLY trustworthy source of iOS sales
# numbers, because the game stores an empty receipt for every iPhone purchase.
# They arrive daily (about a day in arrears), already net of refunds, and never
# include sandbox or TestFlight purchases.
#
# Setup, once:
#   1. App Store Connect -> Users and Access -> Integrations -> App Store
#      Connect API -> generate a key with the "Sales" role (Admin and Finance
#      also work). Download the .p8 — it can only be downloaded ONCE.
#   2. Copy the Issuer ID (shown above the key list) and the Key ID.
#   3. Vendor number: App Store Connect -> Payments and Financial Reports,
#      shown top-left as an 8-digit number.
#   4. Base64-encode the .p8 so its newlines survive as an env var:
#        macOS/Linux: base64 -i AuthKey_XXXXXXXX.p8 | tr -d '\n'
#        Windows:     certutil -encode AuthKey_XXXXXXXX.p8 tmp.b64
APPSTORE_ISSUER_ID=
APPSTORE_KEY_ID=
APPSTORE_VENDOR_NUMBER=
APPSTORE_PRIVATE_KEY_B64=

# --- Passkeys (WebAuthn) for console admin sign-in ---
# Optional locally (defaults to localhost). REQUIRED in production or the
# passkey button stays hidden. Set both on Vercel (Production scope):
#   WEBAUTHN_RP_ID     — registrable domain, e.g. nobilix.com (covers www.)
#   WEBAUTHN_ORIGIN    — exact console origin incl. scheme, e.g. https://www.nobilix.com
# Preview deployments are intentionally unsupported: their per-deploy domains
# can't match a fixed RP ID.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
